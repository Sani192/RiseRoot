# Server-only connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/riseroot

# Optional public variables
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development-only server-side identity bootstrap.
# Use this only for local/test runs before a real auth session is available.
# Never prefix with NEXT_PUBLIC_ and never set in production.
LOCAL_DEV_USER_ID=
